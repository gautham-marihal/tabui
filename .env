# tabui in Docker: copy to .env (next to docker-compose.yml) and fill in. Read by the showcase container when it starts.

# On a server: the domain the showcase is reached on (it must point at the server); Caddy gets its HTTPS certificate
SHOWCASE_DOMAIN=chat.example.com
# (For running the showcase without Docker, the same values go in showcase/.env.local.)

# LiveKit: where the chat and voice calls run
LIVEKIT_URL=wss://mxbot.cimbpoc.tetherfi.cloud
LIVEKIT_API_KEY=APIWnpxRFfYDgcC
LIVEKIT_API_SECRET=LKYfAIc1ZyABjDkZeTQC3iQUengh6fDdmsEkxvz7N88B
LIVEKIT_AGENT_NAME=agent-builder-runtime

# The agents: the Agent Builder API (for the list of agents in the chat) and its key
WEAVE_API_BASE_URL=http://16.79.174.151:8100
WEAVE_API_KEY=UZkrZLh20--x4pca6qGNjxuooEdCnbXAw7NIGeogZSo
# The agent the chat opens on, its environment, and the channel (web-voice takes both speech and typing)
LIVEKIT_BOT_ID=sg-business-banking
LIVEKIT_BOT_REF=development
LIVEKIT_BOT_CHANNEL=web-voice
# The pages allowed to call this server's /api routes (the widget's host page among them), comma separated
# (on a server, add https://SHOWCASE_DOMAIN here)
ALLOWED_ORIGINS_TO_CALL_API=http://localhost:3000,http://localhost:5174,http://localhost:8081

# The bank database (Ashwin's API), for the /crm page
BANK_API_URL=http://16.79.174.151:3322
BANK_REGION=DB2

# Optional: only for the showcase pages that use them
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET_NAME=
# CLERK_SECRET_KEY=
# Built into the image (rebuild after a change): only some older demo pages use these
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# NEXT_PUBLIC_LK_TOKEN_ENDPOINT=
# NEXT_PUBLIC_NIGERIA_ENERGY_BOT_LIVEKIT_URL=

# The guide page (http://localhost:5174): where its chat gets the agents and tokens (the showcase, as the browser
# reaches it), and, on a server, the domain names it may be opened on (comma separated)
# GUIDE_TOKEN_API=http://localhost:3000
# GUIDE_ALLOWED_HOSTS=

# Optional: the widget's own host page (docker compose --profile widget)
# ADA_AGENT_ID=sg-business-banking
# The showcase's address as the browser reaches it (the widget adds /api/token and /api/bots itself)
# ADA_AUTH_TOKEN_API=http://localhost:3000
