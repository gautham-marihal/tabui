# Copy to bank/.env and fill in. Environment variables win over this file.
BANK_DATABASE_URL=postgresql+psycopg://bank:bank@localhost:5434/bank
PORT=4310
# A long random key: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# The same value goes in showcase/.env.local as BANK_API_KEY.
BANK_API_KEY=
# Change in any shared setup, then reload the data (python -m bank.seed) so the fingerprints use it
BANK_PEPPER=
