# LiveKit credentials - copy these values into showcase/.env.local
LIVEKIT_URL=wss://YOUR_LIVEKIT_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# Agent dispatch and Weave Studio's GET /bots endpoint
LIVEKIT_AGENT_NAME=agent-builder-runtime
WEAVE_API_BASE_URL=http://localhost:5173/api
LIVEKIT_BOT_ID=nimbus-care
LIVEKIT_BOT_REF=development
ALLOWED_ORIGINS_TO_CALL_API=http://localhost:5174,http://localhost:3000

# Optional integrations (only needed for those Showcase features)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=YOUR_AWS_REGION
AWS_S3_BUCKET_NAME=YOUR_AWS_S3_BUCKET
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY

# The bank's CRM (see ../bank/README.md): where this server reads it, and the key it sends
BANK_API_URL=http://localhost:4310
BANK_API_KEY=THE_SAME_VALUE_AS_IN_bank/.env
# The key Weave Studio's Integrations and agents' tools send to /api/crm, and the sites allowed to call it from a browser
CRM_API_KEY=A_LONG_RANDOM_KEY
CRM_ALLOWED_ORIGINS=http://localhost:5173
